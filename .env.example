# Google Gemini API 설정 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SerpApi 설정 (뉴스 검색용, https://serpapi.com 가입 후 발급)
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxx

# 워드프레스 설정
WP_URL=https://your-domain.com/wp-json/wp/v2/posts
WP_USER=your_admin_username
WP_APP_PASS=xxxx xxxx xxxx xxxx

# 참고사항:
# 1. GEMINI_API_KEY는 https://aistudio.google.com/apikey 에서 무료 발급
# 2. Gemini 2.0 Flash는 무료 할당량이 높고 한국어 성능이 우수합니다
# 3. WP_APP_PASS는 워드프레스 관리자 > 사용자 > 프로필 > Application Passwords에서 생성
# 4. SerpApi는 월 100건 무료, 이후 유료 ($50/5000 searches)
# 5. 실제 사용시 이 파일을 .env로 복사하여 실제 값 입력
